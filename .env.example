# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# These are prefixed EXPO_PUBLIC_ so Expo exposes them to client code —
# only ever put the "publishable" key here, never the "secret" key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe Payment Link and Customer Portal login link for the Competitive
# subscription (both from the Stripe Dashboard — these are public URLs,
# not secrets, safe to expose to client code).
EXPO_PUBLIC_STRIPE_PAYMENT_LINK=
EXPO_PUBLIC_STRIPE_PORTAL_LINK=

# --- Server-only, set these in Vercel's project Environment Variables,
# NOT in this file and NEVER prefixed EXPO_PUBLIC_. Used only by
# api/stripe-webhook.js, which runs on Vercel, never in the browser. ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
