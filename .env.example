# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# These are prefixed EXPO_PUBLIC_ so Expo exposes them to client code —
# only ever put the public "anon" key here, never the service_role key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
